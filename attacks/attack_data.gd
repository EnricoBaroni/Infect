	cloned.chance_split_count = chance_split_count
	cloned.chance_split_spread_degrees = chance_split_spread_degrees
	cloned.chance_split_chance = chance_split_chance
	cloned.chance_split_luck_to_full = chance_split_luck_to_full
	cloned.chance_split_max_chance = chance_split_max_chance
	cloned.spectral = spectral
	cloned.crit_chance = crit_chance
	cloned.crit_multiplier = crit_multiplier
	cloned.crit_luck_to_full = crit_luck_to_full
	cloned.crit_max_chance = crit_max_chance
	cloned.knockback_multiplier = knockback_multiplier
	cloned.knockback_flat_bonus = knockback_flat_bonus
	cloned.explosion_radius = explosion_radius
	cloned.explosion_damage_multiplier = explosion_damage_multiplier
	cloned.explosion_inherits_infection = explosion_inherits_infection
	cloned.explosion_spawn_count = explosion_spawn_count
