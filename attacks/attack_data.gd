	cloned.cadence_shot_explosion_radius = cadence_shot_explosion_radius
	return cloned

func clone_status_payloads() -> Array[StatusPayload]:
	var cloned_payloads: Array[StatusPayload] = []
	for payload in status_payloads:
		if payload == null:
			continue
		cloned_payloads.append(payload.copy())
	return cloned_payloads
