	cloned.continuous_fire = continuous_fire
	cloned.continuous_tick_rate = continuous_tick_rate
	cloned.fracture_on_hit_count = fracture_on_hit_count
	cloned.fracture_spread_degrees = fracture_spread_degrees
	cloned.fracture_damage_multiplier = fracture_damage_multiplier
	cloned.fracture_speed_multiplier = fracture_speed_multiplier
	cloned.fracture_range_multiplier = fracture_range_multiplier
