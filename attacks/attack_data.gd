	cloned.weapon_type = weapon_type
	cloned.beam_segment_count = beam_segment_count
	cloned.beam_segment_spacing = beam_segment_spacing
	cloned.beam_segment_duration = beam_segment_duration
	cloned.homing_strength = homing_strength
	cloned.homing_radius = homing_radius
