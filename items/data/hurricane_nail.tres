[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/knockback_modifier_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/piercing_projectiles_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_knockback"]
resource_name = "KnockbackModifierEffect"
