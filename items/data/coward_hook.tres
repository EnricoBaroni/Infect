[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/fear_status_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/explosive_projectiles_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_fear"]
resource_name = "FearStatusEffect"
script = ExtResource("2")
duration = 2.0
intensity = 1.0
max_stacks = 1
stack_rule = "refresh"

[sub_resource type="Resource" id="Resource_explosion"]
resource_name = "ExplosiveProjectilesEffect"
script = ExtResource("3")
explosion_radius = 20.0
extra_explosion_damage_multiplier = 0.2
inherit_infection = true

[resource]
script = ExtResource("1")
id = "coward_hook"
name = "Coward Hook"
description = "Fear plus small panic blasts."
quality = 3
pool_tags = PackedStringArray("treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_fear"), SubResource("Resource_explosion")])
