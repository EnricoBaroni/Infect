[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/split_shots_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/fire_rate_up_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_split"]
resource_name = "SplitShotsEffect"
script = ExtResource("2")
extra_shots = 1
spread_degrees = 16.0

[sub_resource type="Resource" id="Resource_fire_rate"]
resource_name = "FireRateUpEffect"
script = ExtResource("3")
amount = 0.05

[resource]
script = ExtResource("1")
id = "scatter_core"
name = "Scatter Core"
description = "Split shots and tears up."
quality = 3
pool_tags = PackedStringArray("treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_split"), SubResource("Resource_fire_rate")])
