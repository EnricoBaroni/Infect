[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/directional_shot_appender_effect.gd" id="2"]

[sub_resource type="Resource" id="Resource_appender"]
resource_name = "DirectionalShotAppenderEffect"
script = ExtResource("2")
angle_offsets_degrees = [45.0, -45.0, 135.0, -135.0]

[resource]
script = ExtResource("1")
id = "diagonal_shot"
name = "Diagonal Shot"
description = "Every shot also fires bullets in all four diagonal directions."
quality = 3
pool_tags = PackedStringArray("treasure", "gacha")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_appender")])
