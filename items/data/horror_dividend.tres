[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/fear_status_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/gain_drops_on_kill_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_fear"]
resource_name = "FearStatusEffect"
script = ExtResource("2")
duration = 2.3
intensity = 1.0
max_stacks = 1
stack_rule = "refresh"

[sub_resource type="Resource" id="Resource_kill_drops"]
resource_name = "GainDropsOnKillEffect"
script = ExtResource("3")
drops_per_kill = 1
infected_bonus = 1

[resource]
script = ExtResource("1")
id = "horror_dividend"
name = "Horror Dividend"
description = "Fearful kills pay extra drops."
quality = 4
pool_tags = PackedStringArray("treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_fear"), SubResource("Resource_kill_drops")])
