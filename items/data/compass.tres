[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/map_reveal_effect.gd" id="2"]

[sub_resource type="Resource" id="Resource_map"]
resource_name = "MapRevealEffect"
script = ExtResource("2")
reveal_room_types = true
reveal_treasure_rooms = true
reveal_boss_rooms = true

[resource]
script = ExtResource("1")
id = "compass"
name = "Compass"
description = "Reveals major room types."
quality = 3
pool_tags = PackedStringArray("shop", "treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_map")])