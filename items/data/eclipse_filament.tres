[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/spectral_projectiles_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/split_shots_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_spectral"]
resource_name = "SpectralProjectilesEffect"
script = ExtResource("2")

[sub_resource type="Resource" id="Resource_split"]
resource_name = "SplitShotsEffect"
script = ExtResource("3")
extra_shots = 1
spread_degrees = 10.0

[resource]
script = ExtResource("1")
id = "eclipse_filament"
name = "Eclipse Filament"
description = "Spectral split tears."
quality = 4
pool_tags = PackedStringArray("treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_spectral"), SubResource("Resource_split")])
