[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://items/data/item_data.gd" id="1"]
[ext_resource type="Script" path="res://items/effects/effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://items/effects/slow_status_effect.gd" id="2"]
[ext_resource type="Script" path="res://items/effects/split_shots_effect.gd" id="3"]

[sub_resource type="Resource" id="Resource_slow"]
resource_name = "SlowStatusEffect"
script = ExtResource("2")
duration = 2.0
speed_multiplier = 0.68
max_stacks = 2
stack_rule = "stack_duration"

[sub_resource type="Resource" id="Resource_split"]
resource_name = "SplitShotsEffect"
script = ExtResource("3")
extra_shots = 1
spread_degrees = 10.0

[resource]
script = ExtResource("1")
id = "heavy_snow"
name = "Heavy Snow"
description = "Split tears spread layered slow."
quality = 3
pool_tags = PackedStringArray("treasure")
effects = Array[ExtResource("1_effect")]([SubResource("Resource_slow"), SubResource("Resource_split")])
